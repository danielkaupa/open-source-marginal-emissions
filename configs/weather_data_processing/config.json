{
  "parallelization": {
    "mode": "manual",
    "manual_workers": 2,
    "prefer_mpi": true
  },
  "logging": {
    "verbose": false,
    "log_dir": "weather_data_processing",
    "log_level": "INFO"
  },
  "data_paths": {
    "grib_dir": "era5-world/raw",
    "output_base": "era5-world/processed",
    "interim_dir": "era5-world/interim",
    "processed_dir": "era5-world/processed"
  },
  "geographic": {
    "boundary": {
      "shapefile_adm0": "geoBoundaries/geoBoundariesCGAZ_ADM0.zip",
      "shapefile_adm1": "geoBoundaries/geoBoundariesCGAZ_ADM1.zip",
      "shapefile_adm2": "geoBoundaries/geoBoundariesCGAZ_ADM2.zip",
      "country_name": "India",
      "country_field": "shapeName"
    },
    "adm_enrichment": {
      "enable_adm0": true,
      "enable_adm1": true,
      "enable_adm2": true,
      "adm0_name_field": "shapeName",
      "adm0_code_field": "shapeGroup",
      "adm1_name_field": "shapeName",
      "adm2_name_field": "shapeName",
      "adm1_code_field": "shapeID",
      "adm2_code_field": "shapeID",
      "undefined_value": "NONE_DEFINED"
    },
    "masks": [
      {
        "inclusion_mode": "centroid",
        "dataset_prefix": "era5-world",
        "mask_dir": "geoBoundaries/masks",
        "metadata_dir": "geoBoundaries/masks/mask_metadata",
        "generate_visualization": true,
        "image_dir": "geoBoundaries/images",
        "exclusion_bboxes": [
          {
            "name": "andaman_nicobar",
            "lon_min": 90.0,
            "lon_max": 95.0,
            "lat_min": -10.0,
            "lat_max": 15.0
          },
          {
            "name": "lakshadweep",
            "lon_min": 71.0,
            "lon_max": 74.0,
            "lat_min": 8.2,
            "lat_max": 11.7
          }
        ]
      }
    ]
  },
  "temporal": {
    "interpolation": {
      "method": "rate_shaped",
      "datetime_unit": "us",
      "clamp_unit_range": true
    },
    "timezone": {
      "target_timezone": "Asia/Kolkata",
      "keep_utc_column": false
    }
  },
  "aggregation": {
    "spatial": {
      "level": "ADM0",
      "weight_by_area": true,
      "output_format": "parquet"
    }
  },
    "temporal_partitioning": {
      "modes": [
        "annual"
      ]
    }
  }
